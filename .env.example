# ===========================================
# Mystic AI - Environment Variables
# ===========================================
# Copy this file to .env and adjust values

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=mystic
DB_PASSWORD=mystic123

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=mystic
RABBITMQ_PASSWORD=mystic123
RABBITMQ_VHOST=mystic

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mystic123

# Eureka
EUREKA_URL=http://localhost:8761/eureka/

# Startup orchestration timeouts (seconds)
EUREKA_STARTUP_TIMEOUT_SECONDS=60
AUTH_STARTUP_TIMEOUT_SECONDS=90
GATEWAY_STARTUP_TIMEOUT_SECONDS=90
ASTROLOGY_STARTUP_TIMEOUT_SECONDS=180
NUMEROLOGY_STARTUP_TIMEOUT_SECONDS=120
DREAM_STARTUP_TIMEOUT_SECONDS=120
ORACLE_STARTUP_TIMEOUT_SECONDS=120
NOTIFICATION_STARTUP_TIMEOUT_SECONDS=120
VISION_STARTUP_TIMEOUT_SECONDS=120
SPIRITUAL_STARTUP_TIMEOUT_SECONDS=120

# Keep auth/gateway available even if slower domain services are still booting.
# Set to true only if your environment requires strict full-stack readiness before gateway startup.
WAIT_FOR_OPTIONAL_SERVICES_BEFORE_GATEWAY=false

# JWT
JWT_SECRET=bXlzdGljLWFpLXNlY3JldC1rZXktZm9yLWp3dC10b2tlbi1nZW5lcmF0aW9uLW11c3QtYmUtYXQtbGVhc3QtMjU2LWJpdHM=

# RevenueCat Webhook (Phase 2 billing integration)
# Set this to the value RevenueCat displays in
#   Project settings → Integrations → Webhooks → Authorization header.
# It is sent as `Authorization: Bearer <secret>` on every webhook delivery.
# Leave empty in local dev and set REVENUECAT_WEBHOOK_ALLOW_EMPTY_SECRET=true
# to accept unsigned requests during integration tests.
# Production must keep REVENUECAT_WEBHOOK_ALLOW_EMPTY_SECRET=false.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_ALLOW_EMPTY_SECRET=false
REVENUECAT_WEBHOOK_MAX_PAYLOAD_BYTES=8192

# ayeT Studios Rewarded-Video Callback (notification-service)
# Public callback URL (through gateway): {PUBLIC_BASE_URL}/api/v1/webhooks/ayet/rewarded-video
# Reward amount is server-authoritative — the callback's currency_amount is only validated.
AYET_REWARD_AMOUNT=1
AYET_EXPECTED_CURRENCY_AMOUNT=1
# Pin to the exact ad unit configured in the ayeT panel. Leave blank in dev to skip
# enforcement; set all three in production.
AYET_PLACEMENT_IDENTIFIER=
AYET_REWARDED_ADSLOT_ID=
AYET_CURRENCY_IDENTIFIER=Guru Token
# Reward session TTL (seconds) — user must finish the ad within this window.
AYET_SESSION_TTL_SECONDS=600
AYET_CLEANUP_INTERVAL_MS=300000
# Optional callback authenticity checks — keep disabled until confirmed with ayeT.
# Do NOT enable signature verification before confirming ayeT's official signing scheme.
AYET_SIGNATURE_ENABLED=false
AYET_CALLBACK_SECRET=
AYET_SIGNATURE_PARAM=hash
# IP allowlist for ayeT's postback source IPs (comma-separated). Empty = disabled.
AYET_IP_WHITELIST_ENABLED=false
AYET_ALLOWED_IPS=


CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8090,http://localhost:8500,http://localhost:19000,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:8090,http://127.0.0.1:8500,http://127.0.0.1:19000,http://app.localhost,http://admin.localhost

# Email verification token security
VERIFICATION_TOKEN_PEPPER=change-me-super-secret
VERIFICATION_TOKEN_BYTES=48
VERIFICATION_TOKEN_TTL_HOURS=24
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_RESEND_DAILY_LIMIT=5
VERIFICATION_RETRY_MAX_ATTEMPTS=3
VERIFICATION_RETRY_DELAY_SECONDS=30

# Allowed Google OAuth client IDs (comma-separated) for social login token audience check
GOOGLE_ALLOWED_CLIENT_IDS=607073022009-t0nujj22fr6k33tuhdg1eka9n9eq36t5.apps.googleusercontent.com,607073022009-a1r82mu51cetqtsknk5fjf34kau393g9.apps.googleusercontent.com,699117630000-ectgs3iqcqclqlhrn01e5vtodd0n3lrp.apps.googleusercontent.com,699117630000-ps0os3vtf47ld2ne8qdoer83i1dl3p8i.apps.googleusercontent.com,699117630000-p31ab38e9cbi1p78h17v0grkqogp7an7.apps.googleusercontent.com,699117630000-h31rsh94vq05n6avnki1eiee48q7h4q9.apps.googleusercontent.com,699117630000-f8ejg9frfqhs02fn9c7p9k2o5vqicvus.apps.googleusercontent.com

# AI (for ai-orchestrator service)

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# DeepSeek: deepseekFast (standard/fast requests) and deepseekPro (complex/premium, thinking mode) both read this key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
API_NINJAS_KEY=your_api_ninjas_key_here
AI_LOCAL_LLM_ENABLED=true
AI_LOCAL_LLM_PROVIDER_TYPE=ollama
AI_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
AI_LOCAL_LLM_MODEL=gemma3:4b
AI_LOCAL_LLM_CHAT_ENDPOINT=/api/generate
AI_LOCAL_LLM_TIMEOUT_MS=15000
AI_LOCAL_LLM_RETRY=0
AI_LOCAL_LLM_COOLDOWN=30
AI_LOCAL_LLM_TEMPERATURE=0.7
AI_LOCAL_LLM_MAX_OUTPUT_TOKENS=1024

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Mystic AI"

ENV=local
API_PUBLIC_URL=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8090
EXPO_PUBLIC_COMPARE_ALLOW_MOCK_FALLBACK=false

# GA4 aggregate export (server-side Measurement Protocol)
# Recommended target: a dedicated GA4 web stream for admin/backoffice snapshots.
AUTH_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8088
GA4_EXPORT_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_EXPORT_ENDPOINT=https://www.google-analytics.com/mp/collect
GA4_CLIENT_ID=mystic-admin-server

# "Bugünkü Kişisel Planım" content-quality tunables (astrology-service).
# Bump PERSONAL_PLAN_VERSION whenever the composer or copy catalog changes so previously
# stored plans regenerate without needing a migration.
PERSONAL_PLAN_VERSION=pp-v1
# Days of plan history compared when suppressing repeated suggestions.
PERSONAL_PLAN_HISTORY_DAYS=7
# Jaccard similarity above which two suggestions count as semantic duplicates (0-1).
PERSONAL_PLAN_SIMILARITY_THRESHOLD=0.82
# How many times "Çok genel" / "Tekrarlı" feedback may rebuild a single day's plan.
PERSONAL_PLAN_MAX_REGENERATIONS=2
PERSONAL_PLAN_MAX_AREA_CARDS=2
PERSONAL_PLAN_MAX_TIMELINE_SLOTS=3
# Unity LevelPlay rewarded S2S callback security.
LEVELPLAY_REWARDED_PRIVATE_KEY=
LEVELPLAY_REWARDED_DAILY_LIMIT=10
LEVELPLAY_REWARD_SESSION_TTL_SECONDS=600
LEVELPLAY_ALLOW_UNSIGNED_CALLBACKS=false
