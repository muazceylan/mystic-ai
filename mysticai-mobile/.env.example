#
# Runtime environment
# dev | stage | prod
EXPO_PUBLIC_APP_ENV=dev

# API base URLs by environment (single-source config in src/config/env.ts)
# Dev defaults are resolved automatically (web/iOS/android/device).
# Set this only when you need to force a specific host.
EXPO_PUBLIC_API_BASE_URL_DEV_OVERRIDE=
EXPO_PUBLIC_API_BASE_URL_STAGE=
EXPO_PUBLIC_API_BASE_URL_PROD=

# Legacy fallback (optional). Prefer *_DEV/STAGE/PROD vars above.
EXPO_PUBLIC_API_BASE_URL=

# Spiritual service optional override (dev auto-resolves host and uses port 8091)
EXPO_PUBLIC_SPIRITUAL_API_URL_OVERRIDE=

# Optional mock toggle (only works in __DEV__ and non-prod env)
EXPO_PUBLIC_USE_MOCK=false

EXPO_PUBLIC_FACEBOOK_APP_ID=123456789012345
# Optional alias used by the app if FACEBOOK_APP_ID is not set
EXPO_PUBLIC_META_APP_ID=123456789012345

# Public web content host used for share pages and content links
EXPO_PUBLIC_PUBLIC_BASE_URL=https://info.astroguru.app

# Download / app-entry host used for QR codes and universal link handoff
EXPO_PUBLIC_UNIVERSAL_DOWNLOAD_URL=https://astroguru.app/dl

# Google Places / Maps (companion add/edit location autocomplete + place details + timezone)
# The app checks EXPO_PUBLIC_GOOGLE_PLACES_API_KEY first, then EXPO_PUBLIC_GOOGLE_MAPS_API_KEY
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# AdMob — App IDs are required at native build time (set in app.config.ts via non-EXPO_PUBLIC vars)
# These are read at build time by the Expo config plugin:
ADMOB_ANDROID_APP_ID=ca-app-pub-2129476568906610~2506472009
ADMOB_IOS_APP_ID=ca-app-pub-2129476568906610~1193390335


# These are read at runtime by the mobile app:
# Native rewarded provider: admob | levelplay | none.
# Only the selected provider is initialized.
EXPO_PUBLIC_MOBILE_AD_PROVIDER=admob
# Rewarded ad unit "guru" — format: Rewarded, reward: 1 Gurus
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_UNIT_ID=ca-app-pub-2129476568906610/2039568147
EXPO_PUBLIC_ADMOB_IOS_REWARDED_UNIT_ID=ca-app-pub-2129476568906610/8618386532
# Devices allowed to see test ads and open the Ad Inspector (dev/admob screen).
# Comma-separated. Google logs the required ID on the first ad request:
#   "Use RequestConfiguration.Builder.setTestDeviceIds(Arrays.asList(\"ABC123...\"))"
# Leave EMPTY in production.
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
# Global test ID flag — overridden per-platform by the vars below if set
EXPO_PUBLIC_ADMOB_USE_TEST_IDS=true
# Per-platform overrides (leave commented to inherit global flag)
EXPO_PUBLIC_ADMOB_USE_TEST_IDS_ANDROID=false
EXPO_PUBLIC_ADMOB_USE_TEST_IDS_IOS=true

# Unity LevelPlay (development build / EAS build only; unsupported in Expo Go)
EXPO_PUBLIC_LEVELPLAY_IOS_APP_KEY=
EXPO_PUBLIC_LEVELPLAY_ANDROID_APP_KEY=
EXPO_PUBLIC_LEVELPLAY_IOS_REWARDED_AD_UNIT_ID=bbukhns7xvd31big
EXPO_PUBLIC_LEVELPLAY_ANDROID_REWARDED_AD_UNIT_ID=1rgadsckgrrblm37
# Enables adapter debug logs + validateIntegration only in __DEV__ builds.
EXPO_PUBLIC_LEVELPLAY_DEBUG=false

# Google Tag Manager
# Web uses the standard GTM script snippet; iOS/Android mobile app containers consume Firebase Analytics events.
EXPO_PUBLIC_GTM_WEB_CONTAINER_ID=GTM-P48FMPJB
EXPO_PUBLIC_GTM_IOS_CONTAINER_ID=GTM-5V22DPD4
EXPO_PUBLIC_GTM_ANDROID_CONTAINER_ID=GTM-NNVXTDZB

# Web rewarded ads (GPT / Google Ad Manager)
# Required for mobile-web rewarded flow if the backend ad unit path is unset or placeholder.
EXPO_PUBLIC_GAM_REWARDED_AD_UNIT_PATH=
EXPO_PUBLIC_GAM_REWARDED_PLACEMENT_KEY=web_earn_page

# RevenueCat / IAP
# Real purchases require a development build or EAS/internal build. Expo Go only uses preview mocks.
# Use `sandbox` for internal test builds. Switch to `production` only for release candidates
# that point at live App Store / Google Play products.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=Astro Guru Pro
EXPO_PUBLIC_REVENUECAT_ENV=sandbox

# Google OAuth (social login) — all client IDs must be from the SAME Firebase/Google project.
# Project: astro-guru-57921 (699117630000)
# Web application OAuth client ID — used by expo-auth-session on web and as webClientId
# for @react-native-google-signin/google-signin on native (server client ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android OAuth client ID — used where the SDK explicitly expects androidClientId.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS OAuth client ID — set this only if an iOS OAuth client exists in the same project.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Firebase Web SDK config (web platform only — native reads google-services.json / GoogleService-Info.plist)
# Project: astro-guru-57921 (messagingSenderId: 699117630000)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Analytics — Amplitude (HTTP API based)
# Provider: 'amplitude' | 'none'. Auto-detected if API key is present.
EXPO_PUBLIC_ANALYTICS_PROVIDER=amplitude
EXPO_PUBLIC_ANALYTICS_API_KEY=
EXPO_PUBLIC_ANALYTICS_ENDPOINT=https://api2.amplitude.com/2/httpapi
# Master switch for the shared analytics facade.
# Leave true to allow Firebase Analytics on native builds even when Amplitude is not configured.
EXPO_PUBLIC_ANALYTICS_COLLECTION_ENABLED=true
EXPO_PUBLIC_ANALYTICS_DEBUG=false

# Firebase Analytics (GA4) — native config files (project astro-guru-57921 / 699117630000)
# Android: android/app/google-services.json (already in repo — project_number: 699117630000)
# iOS:     GoogleService-Info.plist (download from Firebase Console for astro-guru-57921 and place in repo root)
# No runtime env var needed for native — Firebase reads config files automatically.
