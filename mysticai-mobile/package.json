{
  "name": "mystic-ai-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8090",
    "verify:ads": "node scripts/verify-native-ad-config.mjs",
    "android": "expo run:android --port 8090",
    "build:android:aab": "node scripts/verify-native-ad-config.mjs --platform android && node scripts/bump-android-version-code.js && sh -c 'set -a && . .env.production && set +a && cd android && ./gradlew bundleReleaseVersioned --no-daemon --no-parallel --max-workers=2'",
    "build:ios:ipa": "node scripts/verify-native-ad-config.mjs --platform ios && node scripts/bump-ios-build-number.js && sh -c 'set -a && . .env.production && set +a && xcodebuild -workspace ios/AstroGuru.xcworkspace -scheme AstroGuru -configuration Release -destination \"generic/platform=iOS\" -archivePath ios/build/AstroGuru.xcarchive archive -allowProvisioningUpdates && xcodebuild -exportArchive -archivePath ios/build/AstroGuru.xcarchive -exportOptionsPlist ios/ExportOptions.plist -exportPath ios/build/ipa -allowProvisioningUpdates' && node scripts/copy-ios-versioned-ipa.js",
    "ios": "expo run:ios --port 8090",
    "web": "expo start --web --port 8090",
    "build:web": "expo export --platform web",
    "check:contrast": "node ./scripts/contrast-check.js",
    "qa:guideline-4.3b": "node ./scripts/qa/guideline-4.3b-static-qa.mjs",
    "test:subscription": "node ./scripts/qa/subscription-state.test.mjs",
    "qa:app-store": "node ./scripts/qa/app-store-subscription-att.test.mjs",
    "qa:app-version": "node ./scripts/qa/app-version-policy.test.mjs",
    "qa:natal-portrait": "node ./scripts/qa/natal-portrait.test.mjs"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.5.52",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@tanstack/query-persist-client-core": "^5.91.19",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.6.8",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "^55.0.9",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-screen-capture": "~8.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.13.0",
    "i18next": "^25.8.11",
    "lucide-react-native": "^0.575.0",
    "nativewind": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.3.0",
    "react-native-pager-view": "6.9.1",
    "react-native-purchases": "^10.4.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.0.0",
    "react-native-view-shot": "~4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.0",
    "unity-levelplay-mediation": "9.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
